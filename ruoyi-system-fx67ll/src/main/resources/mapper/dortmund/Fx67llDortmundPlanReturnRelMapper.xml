<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.fx67ll.dortmund.mapper.Fx67llDortmundPlanReturnRelMapper">

    <resultMap type="Fx67llDortmundPlanReturnRel" id="Fx67llDortmundPlanReturnRelResult">
        <result property="relId" column="rel_id"/>
        <result property="planId" column="plan_id"/>
        <result property="combinationId" column="combination_id"/>
        <result property="relSort" column="rel_sort"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectListByPlanId" resultMap="Fx67llDortmundPlanReturnRelResult">
        select rel_id,
               plan_id,
               combination_id,
               rel_sort,
               create_by,
               create_time,
               update_by,
               update_time
        from fx67ll_dortmund_plan_return_rel
        where plan_id = #{planId}
        order by rel_sort, rel_id
    </select>

    <select id="selectPlanIdByCombinationId" resultType="Long">
        select plan_id
        from fx67ll_dortmund_plan_return_rel
        where combination_id = #{combinationId}
    </select>

    <insert id="insertFx67llDortmundPlanReturnRel" parameterType="Fx67llDortmundPlanReturnRel"
            useGeneratedKeys="true" keyProperty="relId">
        insert into fx67ll_dortmund_plan_return_rel
        (plan_id, combination_id, rel_sort, create_by, create_time, update_by, update_time)
        values
        (#{planId}, #{combinationId}, #{relSort}, #{createBy}, #{createTime}, #{updateBy}, #{updateTime})
    </insert>

    <delete id="deleteByPlanId">
        delete
        from fx67ll_dortmund_plan_return_rel
        where plan_id = #{planId}
    </delete>
</mapper>
