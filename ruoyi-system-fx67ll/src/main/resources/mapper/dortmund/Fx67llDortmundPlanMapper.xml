<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.fx67ll.dortmund.mapper.Fx67llDortmundPlanMapper">

    <resultMap type="Fx67llDortmundPlan" id="Fx67llDortmundPlanResult">
        <result property="planId" column="plan_id"/>
        <result property="planContent" column="plan_content"/>
        <result property="planRate" column="plan_rate"/>
        <result property="planAmount" column="plan_amount"/>
        <result property="planRemark" column="plan_remark"/>
        <result property="calculatedPlanRate" column="calculated_plan_rate"/>
        <result property="calculatedPlanAmount" column="calculated_plan_amount"/>
        <result property="summaryContent" column="summary_content"/>
        <result property="summaryUpdateFlag" column="summary_update_flag"/>
        <result property="summaryUpdateTime" column="summary_update_time"/>
        <result property="userId" column="user_id"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectFx67llDortmundPlanVo">
        select plan_id,
               plan_content,
               plan_rate,
               plan_amount,
               plan_remark,
               calculated_plan_rate,
               calculated_plan_amount,
               summary_content,
               summary_update_flag,
               summary_update_time,
               user_id,
               create_by,
               create_time,
               update_by,
               update_time,
               del_flag
        from fx67ll_dortmund_plan
    </sql>

    <select id="selectFx67llDortmundPlanList" parameterType="Fx67llDortmundPlan"
            resultMap="Fx67llDortmundPlanResult">
        <include refid="selectFx67llDortmundPlanVo"/>
        <where>
            <if test="planId != null ">and plan_id = #{planId}</if>
            <if test="planContent != null  and planContent != ''">and plan_content like concat('%', #{planContent},
                '%')
            </if>
            <if test="planRemark != null  and planRemark != ''">and plan_remark like concat('%', #{planRemark},
                '%')
            </if>
            <if test="delFlag != null  and delFlag != ''">and del_flag = #{delFlag}</if>
            <if test="userId != null ">and user_id = #{userId}</if>
            <if test="createBy != null  and createBy != ''">and create_by like concat('%',
                #{createBy}, '%')
            </if>
            <if test="beginCreateTime != null and beginCreateTime != '' and endCreateTime != null and endCreateTime != ''">and create_time between #{beginCreateTime} and
                #{endCreateTime}
            </if>
            <if test="updateBy != null  and updateBy != ''">and update_by like concat('%',
                #{updateBy}, '%')
            </if>
            <if test="beginUpdateTime != null and beginUpdateTime != '' and endUpdateTime != null and endUpdateTime != ''">and update_time between #{beginUpdateTime} and
                #{endUpdateTime}
            </if>
            <if test="matchId != null">
                and plan_id in (select plan_id from fx67ll_dortmund_plan_match_rel where match_id = #{matchId})
            </if>
        </where>
        order by STR_TO_DATE(create_time, "%Y-%m-%d %H:%i:%s") desc
    </select>

    <select id="selectFx67llDortmundPlanByPlanId" parameterType="Long" resultMap="Fx67llDortmundPlanResult">
        <include refid="selectFx67llDortmundPlanVo"/>
        where plan_id = #{planId}
    </select>

    <insert id="insertFx67llDortmundPlan" parameterType="Fx67llDortmundPlan" useGeneratedKeys="true"
            keyProperty="planId">
        insert into fx67ll_dortmund_plan
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="planContent != null and planContent != ''">plan_content,</if>
            <if test="planRate != null">plan_rate,</if>
            <if test="planAmount != null">plan_amount,</if>
            <if test="planRemark != null">plan_remark,</if>
            <if test="calculatedPlanRate != null">calculated_plan_rate,</if>
            <if test="calculatedPlanAmount != null">calculated_plan_amount,</if>
            <if test="summaryContent != null">summary_content,</if>
            <if test="summaryUpdateFlag != null">summary_update_flag,</if>
            <if test="summaryUpdateTime != null">summary_update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="userId != null">user_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="planContent != null and planContent != ''">#{planContent},</if>
            <if test="planRate != null">#{planRate},</if>
            <if test="planAmount != null">#{planAmount},</if>
            <if test="planRemark != null">#{planRemark},</if>
            <if test="calculatedPlanRate != null">#{calculatedPlanRate},</if>
            <if test="calculatedPlanAmount != null">#{calculatedPlanAmount},</if>
            <if test="summaryContent != null">#{summaryContent},</if>
            <if test="summaryUpdateFlag != null">#{summaryUpdateFlag},</if>
            <if test="summaryUpdateTime != null">#{summaryUpdateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="userId != null">#{userId},</if>
        </trim>
    </insert>

    <update id="updateFx67llDortmundPlan" parameterType="Fx67llDortmundPlan">
        update fx67ll_dortmund_plan
        <trim prefix="SET" suffixOverrides=",">
            <if test="planContent != null and planContent != ''">plan_content = #{planContent},</if>
            <if test="planRate != null">plan_rate = #{planRate},</if>
            <if test="planAmount != null">plan_amount = #{planAmount},</if>
            <if test="planRemark != null">plan_remark = #{planRemark},</if>
            <if test="calculatedPlanRate != null">calculated_plan_rate = #{calculatedPlanRate},</if>
            <if test="calculatedPlanAmount != null">calculated_plan_amount = #{calculatedPlanAmount},</if>
            <if test="summaryContent != null">summary_content = #{summaryContent},</if>
            <if test="summaryUpdateFlag != null">summary_update_flag = #{summaryUpdateFlag},</if>
            <if test="summaryUpdateTime != null">summary_update_time = #{summaryUpdateTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where plan_id = #{planId}
    </update>

    <update id="updateFx67llDortmundPlanPhase15" parameterType="Fx67llDortmundPlan">
        update fx67ll_dortmund_plan
        set plan_content = #{planContent},
            plan_rate = #{planRate},
            plan_amount = #{planAmount},
            plan_remark = #{planRemark},
            calculated_plan_rate = #{calculatedPlanRate},
            calculated_plan_amount = #{calculatedPlanAmount},
            summary_update_flag = #{summaryUpdateFlag},
            update_by = #{updateBy},
            update_time = #{updateTime}
        where plan_id = #{planId}
    </update>

    <update id="updateFx67llDortmundPlanSummary" parameterType="Fx67llDortmundPlan">
        update fx67ll_dortmund_plan
        set summary_content = #{summaryContent},
            summary_update_flag = #{summaryUpdateFlag},
            summary_update_time = #{summaryUpdateTime},
            update_by = #{updateBy},
            update_time = #{updateTime}
        where plan_id = #{planId}
    </update>

    <update id="markSummaryUpdateByMatchId" parameterType="Long">
        update fx67ll_dortmund_plan p
                 join fx67ll_dortmund_plan_match_rel r on r.plan_id = p.plan_id
        set p.summary_update_flag = 'Y',
            p.update_time = now()
        where r.match_id = #{matchId}
          and p.del_flag = '0'
    </update>

    <delete id="deleteFx67llDortmundPlanByPlanId" parameterType="Long">
        delete
        from fx67ll_dortmund_plan
        where plan_id = #{planId}
    </delete>

    <delete id="deleteFx67llDortmundPlanByPlanIds" parameterType="String">
        delete from fx67ll_dortmund_plan where plan_id in
        <foreach item="planId" collection="array" open="(" separator="," close=")">
            #{planId}
        </foreach>
    </delete>
</mapper>
