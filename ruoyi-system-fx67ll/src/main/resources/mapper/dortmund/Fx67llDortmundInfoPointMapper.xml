    </resultMap>

    <sql id="selectFx67llDortmundInfoPointVo">
        select p.info_point_id,
               p.info_point_type,
               p.season_id,
               s.season_name as season_name,
               p.match_id,
               m.match_time  as match_time,
               ht.team_name  as home_team_name,
               at.team_name  as away_team_name,
               p.point_title,
               p.point_content,
               p.source_name,
               p.source_url,
               p.source_publish_time,
               p.collect_time,
               p.effective_start_time,
               p.effective_end_time,
               p.point_status,
               p.allow_public,
               p.point_remark,
               p.user_id,
               p.create_by,
               p.create_time,
               p.update_by,
               p.update_time
        from fx67ll_dortmund_info_point p
                 left join fx67ll_dortmund_season s on p.season_id = s.season_id
                 left join fx67ll_dortmund_match m on p.match_id = m.match_id
                 left join fx67ll_dortmund_team ht on m.home_team_id = ht.team_id
                 left join fx67ll_dortmund_team at on m.away_team_id = at.team_id
    </sql>

    <select id="selectFx67llDortmundInfoPointList" parameterType="Fx67llDortmundInfoPoint"
            resultMap="Fx67llDortmundInfoPointResult">
        <include refid="selectFx67llDortmundInfoPointVo"/>
        <where>
            <if test="infoPointId != null ">and p.info_point_id = #{infoPointId}</if>
            <if test="infoPointType != null  and infoPointType != ''">and p.info_point_type = #{infoPointType}</if>
            <if test="seasonId != null ">and p.season_id = #{seasonId}</if>
            <if test="matchId != null ">and p.match_id = #{matchId}</if>
            <if test="pointStatus != null  and pointStatus != ''">and p.point_status = #{pointStatus}</if>
            <if test="allowPublic != null  and allowPublic != ''">and p.allow_public = #{allowPublic}</if>
            <if test="pointTitle != null  and pointTitle != ''">and p.point_title like concat('%', #{pointTitle},
                '%')
            </if>
            <if test="pointContent != null  and pointContent != ''">and p.point_content like concat('%',
                #{pointContent}, '%')
            </if>
            <if test="sourceName != null  and sourceName != ''">and p.source_name like concat('%', #{sourceName},
                '%')
            </if>
            <if test="userId != null ">and p.user_id = #{userId}</if>
            <if test="createBy != null  and createBy != ''">and p.create_by like concat('%',
                #{createBy}, '%')
            </if>
            <if test="beginCreateTime != null and endCreateTime != ''">and p.create_time between #{beginCreateTime} and
                #{endCreateTime}
            </if>
            <if test="updateBy != null  and updateBy != ''">and p.update_by like concat('%',
                #{updateBy}, '%')
            </if>
            <if test="beginUpdateTime != null and endUpdateTime != ''">and p.update_time between #{beginUpdateTime} and
                #{endUpdateTime}
            </if>
        </where>
        order by STR_TO_DATE(p.create_time, "%Y-%m-%d %H:%i:%s") desc
    </select>

    <select id="selectFx67llDortmundInfoPointByInfoPointId" parameterType="Long"
            resultMap="Fx67llDortmundInfoPointResult">
        <include refid="selectFx67llDortmundInfoPointVo"/>
        where p.info_point_id = #{infoPointId}
    </select>

