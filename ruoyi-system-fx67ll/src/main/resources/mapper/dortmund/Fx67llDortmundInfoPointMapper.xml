    <resultMap type="Fx67llDortmundInfoPoint" id="Fx67llDortmundInfoPointResult">
        <result property="infoPointId" column="info_point_id"/>
        <result property="infoPointType" column="info_point_type"/>
        <result property="seasonId" column="season_id"/>
        <result property="seasonName" column="season_name"/>
        <result property="matchId" column="match_id"/>
        <result property="matchTime" column="match_time"/>
        <result property="homeTeamName" column="home_team_name"/>
        <result property="awayTeamName" column="away_team_name"/>
        <result property="pointTitle" column="point_title"/>
        <result property="pointContent" column="point_content"/>
        <result property="sourceName" column="source_name"/>
        <result property="sourceUrl" column="source_url"/>
