            <if test="pointTitle != null and pointTitle != ''">point_title,</if>
            <if test="pointContent != null and pointContent != ''">point_content,</if>
            <if test="sourceName != null and sourceName != ''">source_name,</if>
            <if test="sourceUrl != null">source_url,</if>
            <if test="sourcePublishTime != null">source_publish_time,</if>
            <if test="collectTime != null">collect_time,</if>
            <if test="effectiveStartTime != null">effective_start_time,</if>
            <if test="effectiveEndTime != null">effective_end_time,</if>
            <if test="pointStatus != null">point_status,</if>
            <if test="allowPublic != null">allow_public,</if>
            <if test="pointRemark != null">point_remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="userId != null">user_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="infoPointType != null and infoPointType != ''">#{infoPointType},</if>
            <if test="seasonId != null">#{seasonId},</if>
